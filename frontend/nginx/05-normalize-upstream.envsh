#!/bin/sh
# Sourced by the nginx image entrypoint before the template is rendered.
# Values pasted into a dashboard often carry spaces, quotes or a trailing ";" or "/",
# which would break nginx syntax. Clean them up, and refuse to start on anything that is
# still not a plain http(s)://host[:port] URL so the error is obvious in the logs.
raw="${API_UPSTREAM:-}"
clean=$(printf '%s' "$raw" | tr -d ' \t\r\n"'"'"';' | sed 's#/*$##')

if ! printf '%s' "$clean" | grep -Eq '^https?://[A-Za-z0-9.-]+(:[0-9]+)?$'; then
    echo "API_UPSTREAM must look like http://host:port (received: '$raw'). Check the service variables." >&2
    exit 1
fi

export API_UPSTREAM="$clean"
echo "API gateway upstream: $API_UPSTREAM"

# Which address identifies the client for the API's rate limits:
#   edge   -> X-Real-IP written by the platform edge (Railway), falling back to the socket
#   socket -> TCP peer address (no trusted proxy in front, e.g. local Docker)
case "${CLIENT_IP_SOURCE:-edge}" in
    edge) export CLIENT_IP_VAR='$edge_client_ip' ;;
    socket) export CLIENT_IP_VAR='$remote_addr' ;;
    *) echo "CLIENT_IP_SOURCE must be 'edge' or 'socket' (received: '$CLIENT_IP_SOURCE')" >&2; exit 1 ;;
esac
echo "Client IP source: ${CLIENT_IP_SOURCE:-edge}"
