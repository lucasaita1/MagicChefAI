# Rendered by the nginx image entrypoint (envsubst): PORT, API_UPSTREAM and
# NGINX_LOCAL_RESOLVERS come from the environment; nginx variables are left untouched.
# API_UPSTREAM is validated first by 05-normalize-upstream.envsh.

# Real client IP = last hop appended to X-Forwarded-For by the platform edge (cannot be
# forged by the client, who can only prepend values). Falls back to the socket address.
map $http_x_forwarded_for $client_ip {
    "~(?<last_hop>[^,\s]+)\s*$" $last_hop;
    default                     $remote_addr;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    server_tokens off;
    client_max_body_size 64k;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Re-resolve the private API hostname so redeploys (new private IP) keep working
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;

    # TEMPORARY: inspect which client-IP headers the platform edge sets (removed after use)
    location = /__ipdebug {
        default_type text/plain;
        return 200 "remote=$remote_addr\nxff=$http_x_forwarded_for\nx_real_ip=$http_x_real_ip\nx_envoy_external=$http_x_envoy_external_address\ncf=$http_cf_connecting_ip\ntrue_client=$http_true_client_ip\nfastly=$http_fastly_client_ip\nforwarded=$http_forwarded\nx_client_ip=$http_x_client_ip\nx_railway_request_id=$http_x_railway_request_id\n";
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Same-origin API gateway: the browser only ever talks to this domain, so the
    # SameSite=Strict fingerprint cookie works and the API needs no public domain.
    location /api/ {
        # Requests from this same domain are same-origin, so CORS does not apply: drop
        # their Origin header so the API never depends on knowing the public domain.
        # Any other origin is forwarded untouched and rejected by the API's CORS rules.
        set $forward_origin $http_origin;
        if ($http_origin = "https://$host") {
            set $forward_origin "";
        }
        if ($http_origin = "http://$http_host") {
            set $forward_origin "";
        }
        proxy_set_header Origin $forward_origin;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
