# Rendered by the nginx image entrypoint (envsubst): PORT, API_UPSTREAM, CLIENT_IP_VAR and
# NGINX_LOCAL_RESOLVERS come from the environment; nginx variables are left untouched.
# API_UPSTREAM and CLIENT_IP_VAR are prepared by 05-normalize-upstream.envsh.

# Real client IP. On Railway the edge overwrites X-Real-IP with the true client address
# (values sent by the client are discarded), so it is trusted when CLIENT_IP_SOURCE=edge.
# Without an edge in front (local Docker), the socket address is used instead.
map $http_x_real_ip $edge_client_ip {
    ""      $remote_addr;
    default $http_x_real_ip;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    server_tokens off;
    client_max_body_size 64k;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Re-resolve the private API hostname so redeploys (new private IP) keep working
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Same-origin API gateway: the browser only ever talks to this domain, so the
    # SameSite=Strict fingerprint cookie works and the API needs no public domain.
    location /api/ {
        # Requests from this same domain are same-origin, so CORS does not apply: drop
        # their Origin header so the API never depends on knowing the public domain.
        # Any other origin is forwarded untouched and rejected by the API's CORS rules.
        set $forward_origin $http_origin;
        if ($http_origin = "https://$host") {
            set $forward_origin "";
        }
        if ($http_origin = "http://$http_host") {
            set $forward_origin "";
        }
        proxy_set_header Origin $forward_origin;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP ${CLIENT_IP_VAR};
        proxy_set_header X-Forwarded-For ${CLIENT_IP_VAR};
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
