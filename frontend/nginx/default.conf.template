# Rendered by the nginx image entrypoint (envsubst): PORT, API_UPSTREAM and
# NGINX_LOCAL_RESOLVERS come from the environment; nginx variables are left untouched.
# API_UPSTREAM is validated first by 05-normalize-upstream.envsh.

# Real client IP = last hop appended to X-Forwarded-For by the platform edge (cannot be
# forged by the client, who can only prepend values). Falls back to the socket address.
map $http_x_forwarded_for $client_ip {
    "~(?<last_hop>[^,\s]+)\s*$" $last_hop;
    default                     $remote_addr;
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    server_tokens off;
    client_max_body_size 64k;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Re-resolve the private API hostname so redeploys (new private IP) keep working
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Same-origin API gateway: the browser only ever talks to this domain, so the
    # SameSite=Strict fingerprint cookie works and the API needs no public domain.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
    }

    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
