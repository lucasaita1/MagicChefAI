# Copy to .env and fill in. NEVER commit the real .env.

# --- Spring Boot backend ---
DATABASE_URL=jdbc:postgresql://localhost:5433/magic_chef_ai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Postgres container (docker-compose) ---
POSTGRES_DB=magic_chef_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- E-mail confirmation (Resend: https://resend.com/api-keys) ---
# Empty key = links are printed in the API log (local development only)
RESEND_API_KEY=re_your-key-here
# Sender must use a domain verified in Resend
MAIL_FROM=MagicChefAI <no-reply@your-domain.com>
# Public URL of the frontend, used in the confirmation link
APP_BASE_URL=http://localhost:5173

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-with-at-least-32-chars
JWT_TTL=2h
# false only for local http; keep true in production (https)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limits (requests per minute) ---
AI_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=20
REGISTER_IP_RATE_LIMIT=5

# --- Behind a gateway (Railway): header the gateway sets with the real client IP ---
# Leave empty locally. Only trust it when the API is not publicly reachable.
CLIENT_IP_HEADER=
