# Copy to .env and fill in. NEVER commit the real .env.

# --- Spring Boot backend ---
DATABASE_URL=jdbc:postgresql://localhost:5433/magic_chef_ai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Postgres container (docker-compose) ---
POSTGRES_DB=magic_chef_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-with-at-least-32-chars
JWT_TTL=2h
# false only for local http; keep true in production (https)
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limits (requests per minute) ---
AI_RATE_LIMIT=5
LOGIN_RATE_LIMIT=10
